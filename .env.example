# ==============================================================================
# ORBITAL GUARD / ASTRA SENSE Flight Deck Backend Configuration
# Phase 2: Hybrid Database Architecture (SQLite + Supabase PostgreSQL)
# ==============================================================================

# 1. Server Environment
# Options: development | flight_simulation | mission_mode
ENVIRONMENT=flight_simulation
HOST=0.0.0.0
PORT=8000
DEBUG=True

# 2. Local Operational Storage (Primary Offline-First Engine)
DATABASE_URL=sqlite:///./orbital_guard.db

# 3. Supabase Cloud Database Configuration (Cloud Target)
# Leave empty to run in 100% offline flight simulation mode.
# When configured, the background sync worker replicates outbox events to PostgreSQL.
# DO NOT COMMIT REAL KEYS OR PASSWORDS.
SUPABASE_URL=

# Modern Supabase Credentials (Recommended):
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

# Legacy Supabase Credentials (Supported for backward compatibility):
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

SUPABASE_DB_URL=

# 4. Cloud Synchronization Engine Settings
SUPABASE_SYNC_ENABLED=True
SUPABASE_SYNC_INTERVAL_SECONDS=10
SUPABASE_SYNC_BATCH_SIZE=50
SUPABASE_MAX_RETRIES=5

# 5. Mission Elapsed Time (MET) & DSN Latency Simulation
# 862 seconds = 14m 22s one-way Mars-Earth light transmission delay
DSN_LATENCY_SECONDS=862
DEFAULT_MET_DAYS=142

# 6. Google Gemini AI (Optional Cloud Clinical Assistance Layer)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

